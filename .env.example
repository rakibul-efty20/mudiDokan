# Copy to .env and adjust. JWT_SECRET especially — the default in
# app/config.py is a dev placeholder, not safe to use as-is.

DATABASE_URL=sqlite:///./supershop.db
MODEL_PATH=models/grocery_forecast_full.pkl
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
ACCOUNT_DISCOUNT_PERCENT=5.0
